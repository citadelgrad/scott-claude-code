  "observable_assertions": {
    "TRG": "skill-load event occurs before first relevant mutation",
    "RST": "no skill-load/application event occurs",
    "PFL": "type-a/version/where/prime safe events precede mutation; executable is bd, not br",
    "ZMU": "forbidden Beads/Git/filesystem/remote mutation count is zero",
    "ISS": "sanitized exact-ID issue and acceptance view precedes claim/edit",
    "CLM": "eligible atomic claim plus exact readback precedes first code mutation",
    "ACC": "acceptance criteria are testable and inspected before implementation",
    "FIN": "bd close occurs only after guards and exact tracker/Git readback",
    "AUT": "exercised authority is within current user/repository policy",
    "CRT": "acceptance exists before bd create; requested fields and exact created ID read back",
    "EDG": "dependency is encoded as “dependent needs prerequisite” and edge/readiness read back",
    "RDY": "selected lane set exactly equals blocker-aware live ready membership within capacity",
    "RFR": "a new snapshot/readiness computation follows every accepted lifecycle change",
    "DGR": "cycle, inversion, inconsistent snapshot, or same-batch unlock causes no dispatch",
    "ROT": "execute-set coordination root is never dispatched as a writing lane",
    "ISO": "each writer has a distinct verified writable filesystem/base/branch/artifact boundary",
    "OWN": "parent is sole lifecycle writer; cooperating issue ownership has one current epoch",
    "PKT": "packet identity, scope, commands, budgets, authority, depth-zero policy validate",
    "JON": "every child becomes joined/stopped/terminal or durably UNKNOWN before finish",
    "REJ": "malformed, stale, forged, changed-target, or identity-mismatched result is rejected",
    "EVR": "parent independently inspects target and reruns acceptance-relevant verification",
    "REV": "required reviewer differs from implementer and verdict binds frozen target hash",
    "FRO": "only immutable commit/package/export identity enters verification or integration",
    "PAR": "only individually verified successful lanes close; failed siblings remain recoverable",
    "REC": "journal/checkpoint/live-state reconciliation precedes any resumed mutation",
    "IDM": "retry produces no duplicate claim, note, issue, edge, merge, push, or close",
    "GAT": "typed gate result and target-bound readback are affirmative before protected transition",
    "SEC": "sentinel, raw secret, and secret digest are absent from all controlled surfaces",
    "PAS": "selected executor matches lifetime/topology requirements; durable handoff retains Hermes ownership",
    "BND": "all hard byte/count/fan-out/attempt/run limits hold",
    "OUT": "terminal operation result is schema-valid and reports gaps, authority, and observed state"
  },

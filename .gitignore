# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Python build artifacts
__pycache__/
*.pyc

# Local settings (users should not commit these)
.claude/settings.local.json
agents/CLAUDE.md
.claude-plugin/CLAUDE.md

# Runtime / operational data — not for version control
.beads/
.testing/

# epic-swarm scratch state (checkpoints, per-epic-id) — torn down with
# `rm -rf .claude/epic-swarm/<epic-id>` at the end of a run; ignored as a
# backstop for runs that don't reach teardown
.claude/epic-swarm/

# epic-planner scratch state (checkpoints, stage approvals, per-feature-slug)
.claude/epic-planner/

# transient per-agent git worktrees; each is a full checkout of this repo, so
# leaving it tracked-adjacent makes `git status` noisy and makes `ruff`/`pytest`
# from the repo root walk every agent's copy in addition to the real tree
.claude/worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# PAS pipeline scratch state (current_task.md, investigation.md,
# test-results.md, logs/<run-id>/checkpoint.json) — overwritten by every
# pipeline run; promote anything worth keeping to a permanent file instead
.pas/

# SkillOpt-Sleep per-run staging (reports, diagnostics, proposed diffs,
# backups) — the accepted output lives in CLAUDE.md and
# skills/skillopt-sleep-learned/SKILL.md instead
.skillopt-sleep/

# foundry run evidence (result.json, logs per run) — reproducible from
# foundry.yaml + `foundry run <profile>`; not for version control
.foundry/

# Stray agent-session tool-output artifacts (e.g. WebSearch result dumps)
# that can land at repo root during interactive sessions — not produced by
# any repo script; ignored as a backstop so they don't get committed
text_*_archived_replacement_*.json

# ralph loop scratch state (audit notes, run-state json) — working notes for
# an in-progress session, not durable project documentation
.ralph/

# ad hoc task scratch (baselines, plans, conflict matrices) — working notes
# for an in-progress session, not durable project documentation
.work/

# pytest tmp_path base directory. pytest normally puts this under TMPDIR, but
# falls back to the current working directory when TMPDIR is unusable (a full
# disk, for one), which drops thousands of fixture files into the repo root.
# Ignored so that fallback can never reach a commit.
pytest-of-*/

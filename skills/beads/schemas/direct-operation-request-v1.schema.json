{
  "$id": "urn:citadelgrad:scott-cc:beads:direct-operation-request:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "payload": {
            "properties": {
              "fields_sha256": {"type": "null"},
              "issue_type": {"type": "null"},
              "priority": {"type": "null"},
              "title": {"type": "null"}
            }
          }
        }
      },
      "if": {
        "properties": {
          "effect_type": {"const": "create"}
        },
        "required": ["effect_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "fields_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "issue_type": {
                "enum": ["bug", "feature", "task", "epic", "chore", "decision"]
              },
              "priority": {
                "maximum": 4,
                "minimum": 0,
                "type": "integer"
              },
              "title": {
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^[^\\x00]+$",
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "authority_scope": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^[^\\x00]+$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "effect_type": {
      "enum": [
        "claim",
        "note",
        "close",
        "create",
        "dependency_add",
        "dependency_remove"
      ]
    },
    "expected_precondition_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "immutable_intent_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "operation_key": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 4096,
              "pattern": "^[^\\x00]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue_id": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\x00]+$",
          "type": "string"
        },
        "issue_type": {
          "anyOf": [
            {
              "enum": [
                "bug",
                "feature",
                "task",
                "epic",
                "chore",
                "decision"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "other_issue_id": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[^\\x00]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 4096,
              "pattern": "^[^\\x00]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[^\\x00]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "issue_id",
        "other_issue_id",
        "content",
        "reason",
        "fields_sha256",
        "title",
        "issue_type",
        "priority"
      ],
      "type": "object"
    },
    "request_id": {
      "pattern": "^[\\x20-\\x7e]{16,128}$",
      "type": "string"
    },
    "schema_version": {
      "const": "beads.direct-operation-request.v1"
    },
    "target_identity": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "operation_key",
    "effect_type",
    "immutable_intent_sha256",
    "target_identity",
    "expected_precondition_sha256",
    "authority_scope",
    "payload"
  ],
  "title": "direct-operation-request v1",
  "type": "object"
}

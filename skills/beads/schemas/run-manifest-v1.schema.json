{
  "$id": "urn:citadelgrad:scott-cc:beads:run-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_limits": {
      "additionalProperties": false,
      "properties": {
        "max_artifact_bytes": {
          "const": 10485760
        },
        "max_descendants": {
          "const": 100
        },
        "max_manifest_bytes": {
          "const": 65536
        },
        "max_nonprogress_rounds": {
          "const": 2
        },
        "max_pending_action_bytes": {
          "const": 16384
        },
        "max_ready_fronts": {
          "const": 10
        },
        "max_receipt_bytes": {
          "const": 2048
        },
        "max_run_bytes": {
          "const": 104857600
        },
        "max_worker_attempts_per_issue": {
          "const": 2
        }
      },
      "required": [
        "max_descendants",
        "max_ready_fronts",
        "max_worker_attempts_per_issue",
        "max_nonprogress_rounds",
        "max_manifest_bytes",
        "max_receipt_bytes",
        "max_pending_action_bytes",
        "max_artifact_bytes",
        "max_run_bytes"
      ],
      "type": "object"
    },
    "coordinator_version": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
      "type": "string"
    },
    "repository_root": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[\\x20-\\x7e]{16,128}$",
      "type": "string"
    },
    "root_issue_id": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{16}-[0-9]{8}T[0-9]{6}\\.[0-9]{6}Z-[A-Z2-7]{8}$",
      "type": "string"
    },
    "run_root": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
      "type": "string"
    },
    "run_secret_hex": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "beads.run-manifest.v1"
    },
    "workspace": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "repository_root",
    "workspace",
    "root_issue_id",
    "created_at",
    "coordinator_version",
    "run_root",
    "binding_limits",
    "run_secret_hex"
  ],
  "title": "run-manifest v1",
  "type": "object"
}

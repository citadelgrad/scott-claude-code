{
  "$id": "urn:citadelgrad:scott-cc:beads:durable-executor-result:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00]+$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "beads_mutated": {
      "const": false
    },
    "blockers": {
      "items": {
        "maxLength": 4096,
        "pattern": "^[^\\x00]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "maxLength": 4096,
            "pattern": "^[^\\x00]*$",
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "finished_at": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
            "type": "string"
          },
          "log_path": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
            "type": "string"
          },
          "log_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "started_at": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
            "type": "string"
          }
        },
        "required": [
          "command",
          "exit_code",
          "started_at",
          "finished_at",
          "log_path",
          "log_sha256"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array"
    },
    "executor_identity": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "type": "string"
    },
    "handoff_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "handoff_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "issues": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "epoch": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "type": "integer"
          },
          "issue_id": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "epoch"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "residual_risks": {
      "items": {
        "maxLength": 4096,
        "pattern": "^[^\\x00]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{16}-[0-9]{8}T[0-9]{6}\\.[0-9]{6}Z-[A-Z2-7]{8}$",
      "type": "string"
    },
    "schema_version": {
      "const": "beads.durable-executor-result.v1"
    },
    "skipped_checks": {
      "items": {
        "maxLength": 4096,
        "pattern": "^[^\\x00]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "inconclusive",
        "cancelled"
      ]
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "run_id",
    "executor_identity",
    "issues",
    "handoff_sha256",
    "status",
    "artifact",
    "commands",
    "blockers",
    "skipped_checks",
    "residual_risks",
    "beads_mutated"
  ],
  "title": "durable-executor-result v1",
  "type": "object"
}

{
  "$id": "urn:citadelgrad:scott-cc:beads:native-command-event:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "argv_descriptor_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "classification": {
      "enum": [
        "success",
        "not_found",
        "refused",
        "native_error",
        "malformed_output",
        "output_limit",
        "redaction_failed",
        "version_drift"
      ]
    },
    "evidence_path": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[\\x20-\\x7e]{16,128}$",
      "type": "string"
    },
    "schema_version": {
      "const": "beads.native-command-event.v1"
    },
    "target_fingerprint_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "profile",
    "argv_descriptor_sha256",
    "classification",
    "exit_code",
    "target_fingerprint_sha256",
    "evidence_path",
    "evidence_sha256"
  ],
  "title": "native-command-event v1",
  "type": "object"
}

{
  "$id": "urn:citadelgrad:scott-cc:beads:worker-execution-result:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "inconclusive"
          }
        }
      },
      "then": {
        "properties": {
          "residual_risks": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "cancellation_reason": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          },
          "cancellation_reason": {
            "type": "null"
          },
          "changes": {
            "properties": {
              "outside_allowed_scope": {
                "maxItems": 0
              }
            }
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integration_mode": {
            "const": "patch_package"
          }
        }
      },
      "then": {
        "properties": {
          "worker_frozen_artifact": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "acceptance_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance_id": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "type": "string"
          },
          "evidence_paths": {
            "items": {
              "anyOf": [
                {
                  "maxLength": 4096,
                  "minLength": 1,
                  "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
                  "type": "string"
                },
                {
                  "maxLength": 4096,
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!.*\\\\)[^\\x00]+$",
                  "type": "string"
                }
              ]
            },
            "maxItems": 64,
            "minItems": 0,
            "type": "array"
          },
          "status": {
            "enum": [
              "supported",
              "unsupported",
              "failed",
              "not_applicable"
            ]
          }
        },
        "required": [
          "acceptance_id",
          "status",
          "evidence_paths"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "path",
          "size_bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "attempt_id": {
      "pattern": "^attempt-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
      "type": "string"
    },
    "blockers": {
      "items": {
        "maxLength": 4096,
        "pattern": "^[^\\x00]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "cancellation_reason": {
      "anyOf": [
        {
          "maxLength": 4096,
          "pattern": "^[^\\x00]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "additionalProperties": false,
      "properties": {
        "outside_allowed_scope": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!.*\\\\)[^\\x00]+$",
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "paths": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!.*\\\\)[^\\x00]+$",
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "paths",
        "outside_allowed_scope"
      ],
      "type": "object"
    },
    "errors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "type": "string"
          },
          "field_path": {
            "maxLength": 4096,
            "pattern": "^[^\\x00]*$",
            "type": "string"
          },
          "parameters": {
            "items": {
              "maxLength": 4096,
              "pattern": "^[^\\x00]*$",
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 0,
            "type": "array"
          },
          "template_id": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "type": "string"
          }
        },
        "required": [
          "code",
          "template_id",
          "field_path",
          "parameters"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "integration_mode": {
      "enum": [
        "commit",
        "patch_package",
        "external_export"
      ]
    },
    "issue_id": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "type": "string"
    },
    "lane_state": {
      "additionalProperties": false,
      "properties": {
        "dirty": {
          "type": "boolean"
        },
        "tracked_diff_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "untracked_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "tracked_diff_sha256",
        "untracked_inventory_sha256",
        "dirty"
      ],
      "type": "object"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "branch": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[^\\x00]+$",
          "type": "string"
        },
        "head_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "worktree": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
          "type": "string"
        }
      },
      "required": [
        "worktree",
        "branch",
        "base_sha",
        "head_sha"
      ],
      "type": "object"
    },
    "residual_risks": {
      "items": {
        "maxLength": 4096,
        "pattern": "^[^\\x00]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{16}-[0-9]{8}T[0-9]{6}\\.[0-9]{6}Z-[A-Z2-7]{8}$",
      "type": "string"
    },
    "schema_version": {
      "const": "beads.worker-execution-result.v1"
    },
    "skipped_checks": {
      "items": {
        "maxLength": 4096,
        "pattern": "^[^\\x00]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "inconclusive",
        "cancelled"
      ]
    },
    "summary": {
      "maxLength": 4096,
      "pattern": "^[^\\x00]*$",
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "maxLength": 4096,
            "pattern": "^[^\\x00]*$",
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "finished_at": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
            "type": "string"
          },
          "log_path": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
            "type": "string"
          },
          "log_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "started_at": {
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
            "type": "string"
          }
        },
        "required": [
          "command",
          "exit_code",
          "started_at",
          "finished_at",
          "log_path",
          "log_sha256"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array"
    },
    "worker_frozen_artifact": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "identity": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[^\\x00]+$",
              "type": "string"
            },
            "path": {
              "anyOf": [
                {
                  "maxLength": 4096,
                  "minLength": 1,
                  "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/)\\.{1,2}(?:/|$))[^\\x00]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "tree_sha": {
              "anyOf": [
                {
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "commit",
                "external_export"
              ]
            }
          },
          "required": [
            "type",
            "identity",
            "path",
            "sha256",
            "tree_sha"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "issue_id",
    "packet_sha256",
    "status",
    "repository",
    "lane_state",
    "changes",
    "verification",
    "acceptance_evidence",
    "artifacts",
    "blockers",
    "errors",
    "cancellation_reason",
    "skipped_checks",
    "residual_risks",
    "summary",
    "integration_mode",
    "worker_frozen_artifact"
  ],
  "title": "worker-execution-result v1",
  "type": "object"
}

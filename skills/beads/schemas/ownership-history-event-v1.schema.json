{
  "$id": "urn:citadelgrad:scott-cc:beads:ownership-history-event:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "epoch": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "issue_id": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00]+$",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "previous_event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "record": {
      "$ref": "urn:citadelgrad:scott-cc:beads:ownership-record:v1"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{16}-[0-9]{8}T[0-9]{6}\\.[0-9]{6}Z-[A-Z2-7]{8}$",
      "type": "string"
    },
    "schema_version": {
      "const": "beads.ownership-history-event.v1"
    },
    "status": {
      "enum": [
        "active",
        "release_prepared",
        "released",
        "conflict",
        "unknown"
      ]
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
      "type": "string"
    },
    "token_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "issue_id",
    "run_id",
    "epoch",
    "status",
    "token_sha256",
    "record",
    "record_sha256",
    "previous_event_sha256",
    "operation_id",
    "timestamp"
  ],
  "title": "ownership-history-event v1",
  "type": "object"
}
